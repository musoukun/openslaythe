{
  "playback": {
    "version": 1,
    "units": {
      "duration": "seconds",
      "rotation": "degrees clockwise",
      "offset": "pixels at fixed 1200x700; +x right, +y down",
      "screen_shake": "maximum camera displacement in pixels",
      "hit_stop": "seconds",
      "particle_speed": "pixels per second",
      "particle_gravity": "pixels per second squared on +y",
      "scale": "multiplier of native 256x256 texture"
    },
    "origin": "Recipient combatant foot anchor plus offset; keep effect roots fixed in world space at spawn, texture pivot at center. An attack uses the damage recipient; block/heal/status/energy/power uses the recipient; overheat uses the self-damaged owner; death uses the dying unit's last foot position. attack_all emits once per living affected target.",
    "timeline": "All effects listed for one trigger start simultaneously at the resolved gameplay event, not card selection. Main scale and rotation interpolate linearly over duration. Uniform main scale on both axes. random_rotation adds one uniform random angle in [0,360) to both rotation endpoints at spawn. Delete main sprite at duration; particles survive for their lifetime.",
    "alpha_curves": {
      "fade_out": [
        [
